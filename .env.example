SECRET_KEY=<generate-with-python-secrets-token-hex-50>
LOCAL_RUN=True
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
PRODUCTION=False

# Database
DB_HOST=127.0.0.1
DB_NAME=medihub_db
DB_USER=postgres
DB_PASSWORD=<strong-password>
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<strong-password>
USE_REDIS=False

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False

# JWT
JWT_SECRET_KEY=<generate-with-python-secrets-token-hex-50>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_DAYS=1
REFRESH_TOKEN_DAYS=7

# Cookie Security (set True in production with HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Gmail SMTP Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<your-email@gmail.com>
EMAIL_HOST_PASSWORD=<gmail-app-password>
DEFAULT_FROM_EMAIL=Medihub Bangladesh <<your-email@gmail.com>>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-email@gmail.com>
SMTP_PASSWORD=<gmail-app-password>
SMTP_FROM=<your-email@gmail.com>
OTP_EXPIRE_TIME=300

# AWS S3
USE_S3=False
AWS_ACCESS_KEY_ID=<aws-access-key>
AWS_SECRET_ACCESS_KEY=<aws-secret-key>
AWS_STORAGE_BUCKET_NAME=medihub-bucket
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=medihub.s3.amazonaws.com

# Stripe
STRIPE_SECRET_KEY=sk_test_<your-key>
STRIPE_PUBLISHABLE_KEY=pk_test_<your-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-secret>
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# Firebase
FIREBASE_CREDENTIALS_PATH=firebase-key.json

# PostgreSQL image required vars
POSTGRES_DB=medihub_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<strong-password>

# RabbitMQ credentials
RABBITMQ_DEFAULT_USER=medihub
RABBITMQ_DEFAULT_PASS=<strong-password>
